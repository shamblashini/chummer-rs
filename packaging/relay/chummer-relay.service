# systemd unit for chummer-relay.
#   install -m755 target/release/chummer-relay /usr/local/bin/
#   install -Dm644 packaging/relay/relay.example.toml /etc/chummer-relay/relay.toml  (then edit)
#   install -m644 packaging/relay/chummer-relay.service /etc/systemd/system/
#   systemctl enable --now chummer-relay
[Unit]
Description=chummer-rs relay and mailbox
Documentation=https://github.com/shamblashini/chummer-rs/blob/master/docs/relay.md
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/chummer-relay --config /etc/chummer-relay/relay.toml
Environment=RUST_LOG=info,iroh=warn
DynamicUser=yes
StateDirectory=chummer-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
