<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-chummer5">
    <comment>Chummer character</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.chum5"/>
  </mime-type>
  <mime-type type="application/x-chummer5lz">
    <comment>Chummer character (compressed)</comment>
    <sub-class-of type="application/x-lzma"/>
    <glob pattern="*.chum5lz"/>
  </mime-type>
</mime-info>
